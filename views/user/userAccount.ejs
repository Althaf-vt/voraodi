<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Settings | Althaf</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    /* userAccountStyle.css - VOGUE Old Money Menswear Account Dashboard */

/* ============================================
   CSS VARIABLES (Matching all other styles)
   ============================================ */
:root {
  --primary: #1a1a1a;
  --secondary: #2d2d2d;
  --accent: #c9a96e;
  --accent-light: #d4af37;
  --white: #ffffff;
  --off-white: #f8f6f3;
  --cream: #f5f0e8;
  --text-dark: #1a1a1a;
  --text-medium: #4a4a4a;
  --text-light: #8a8a8a;
  --border: #e8e3d9;
  --danger: #dc3545;
  --success: #28a745;
  --warning: #ffc107;
  --info: #17a2b8;
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4px 20px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 8px 40px rgba(0, 0, 0, 0.08);
  --shadow-xl: 0 20px 60px rgba(0, 0, 0, 0.1);
  --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-smooth: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-spring: 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  --transition-elegant: 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --border-radius-sm: 6px;
  --border-radius-md: 10px;
  --border-radius-lg: 16px;
  --border-radius-xl: 24px;
}

/* ============================================
   GLOBAL RESETS & BASE STYLES
   ============================================ */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Montserrat', sans-serif;
  background-color: var(--off-white);
  color: var(--text-dark);
  line-height: 1.6;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ============================================
   CONTAINER
   ============================================ */
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px;
  min-height: 60vh;
  animation: containerFadeIn 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

@keyframes containerFadeIn {
  0% {
    opacity: 0;
    transform: translateY(20px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ============================================
   HEADER
   ============================================ */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40px;
  padding-bottom: 25px;
  border-bottom: 1px solid var(--border);
  flex-wrap: wrap;
  gap: 20px;
  animation: headerSlideDown 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.1s both;
}

@keyframes headerSlideDown {
  0% {
    opacity: 0;
    transform: translateY(-15px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Profile Section */
.profile-section {
  display: flex;
  align-items: center;
  gap: 20px;
}

.profile-image {
  width: 65px;
  height: 65px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--border);
  box-shadow: var(--shadow-md);
  flex-shrink: 0;
  transition: all var(--transition-smooth);
  animation: profileReveal 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55) 0.2s both;
}

@keyframes profileReveal {
  0% {
    opacity: 0;
    transform: scale(0.5);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

.profile-image:hover {
  border-color: var(--accent);
  box-shadow: 0 0 30px rgba(201, 169, 110, 0.2);
  transform: scale(1.05);
}

.profile-section .icon-link {
  width: 65px;
  height: 65px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--off-white);
  border: 2px solid var(--border);
  color: var(--text-light);
  flex-shrink: 0;
  transition: all var(--transition-smooth);
}

.profile-section .icon-link:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.profile-text h1 {
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: -0.5px;
  line-height: 1.3;
  margin: 0;
}

.profile-text h1 span {
  color: var(--accent);
  font-weight: 600;
  display: block;
  font-size: 1.1rem;
  margin-top: 2px;
}

.profile-text p {
  margin: 6px 0 0;
  color: var(--text-medium);
  font-size: 0.9rem;
  font-weight: 400;
}

/* Logout Button */
.logout-btn {
  background: transparent;
  color: var(--text-dark);
  border: 1.5px solid var(--border);
  padding: 12px 24px;
  border-radius: var(--border-radius-sm);
  font-family: 'Montserrat', sans-serif;
  font-weight: 600;
  font-size: 0.85rem;
  cursor: pointer;
  transition: all var(--transition-smooth);
  text-transform: uppercase;
  letter-spacing: 1px;
  white-space: nowrap;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}

.logout-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: var(--danger);
  transition: left 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: -1;
}

.logout-btn:hover {
  color: var(--white);
  border-color: var(--danger);
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(220, 53, 69, 0.2);
}

.logout-btn:hover::before {
  left: 0;
}

.logout-btn:active {
  transform: scale(0.97);
}

/* ============================================
   DASHBOARD GRID
   ============================================ */
.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

/* Dashboard Card */
.dashboard-card {
  background: var(--white);
  border-radius: var(--border-radius-lg);
  padding: 30px;
  border: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-elegant);
  position: relative;
  overflow: hidden;
  opacity: 0;
  animation: cardReveal 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
}

.dashboard-card:nth-child(1) { animation-delay: 0.2s; }
.dashboard-card:nth-child(2) { animation-delay: 0.25s; }
.dashboard-card:nth-child(3) { animation-delay: 0.3s; }
.dashboard-card:nth-child(4) { animation-delay: 0.35s; }
.dashboard-card:nth-child(5) { animation-delay: 0.4s; }
.dashboard-card:nth-child(6) { animation-delay: 0.45s; }

@keyframes cardReveal {
  0% {
    opacity: 0;
    transform: translateY(25px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Card accent top border */
.dashboard-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: var(--accent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.dashboard-card:hover::before {
  transform: scaleX(1);
}

.dashboard-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
  border-color: var(--accent-light);
}

/* Icon Container */
.icon-container {
  width: 50px;
  height: 50px;
  border-radius: var(--border-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  background: rgba(201, 169, 110, 0.08);
  transition: all var(--transition-smooth);
}

.dashboard-card:hover .icon-container {
  background: rgba(201, 169, 110, 0.15);
  transform: scale(1.05);
}

.card-icon {
  width: 22px;
  height: 22px;
  color: var(--accent);
  stroke-width: 1.75;
}

/* Card Content */
.dashboard-card h3 {
  margin: 0 0 10px;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: -0.3px;
}

.dashboard-card p {
  margin: 0 0 20px;
  color: var(--text-medium);
  font-size: 0.85rem;
  line-height: 1.5;
  font-weight: 400;
}

/* Card Link */
.card-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--accent);
  font-weight: 600;
  font-size: 0.85rem;
  text-decoration: none;
  transition: all var(--transition-smooth);
  letter-spacing: 0.3px;
}

.card-link svg {
  transition: transform var(--transition-fast);
}

.card-link:hover {
  color: var(--accent-light);
  gap: 10px;
}

.card-link:hover svg {
  transform: translateX(3px);
}

/* ============================================
   CARD COLOR VARIATIONS
   ============================================ */
/* Security Card */
.card-security::before {
  background: var(--success);
}

.card-security .icon-container {
  background: rgba(40, 167, 69, 0.08);
}

.card-security .card-icon {
  color: var(--success);
}

.card-security:hover {
  border-color: var(--success);
}

.card-security:hover .icon-container {
  background: rgba(40, 167, 69, 0.15);
}

.card-security .card-link {
  color: var(--success);
}

.card-security .card-link:hover {
  color: #1e7e34;
}

/* Address Card */
.card-address::before {
  background: var(--text-medium);
}

.card-address .icon-container {
  background: rgba(74, 74, 74, 0.08);
}

.card-address .card-icon {
  color: var(--text-medium);
}

.card-address:hover {
  border-color: var(--text-medium);
}

.card-address:hover .icon-container {
  background: rgba(74, 74, 74, 0.15);
}

.card-address .card-link {
  color: var(--text-medium);
}

.card-address .card-link:hover {
  color: var(--text-dark);
}

/* Wallet Card */
.card-wallet::before {
  background: var(--primary);
}

.card-wallet .icon-container {
  background: rgba(26, 26, 26, 0.08);
}

.card-wallet .card-icon {
  color: var(--primary);
}

.card-wallet:hover {
  border-color: var(--primary);
}

.card-wallet:hover .icon-container {
  background: rgba(26, 26, 26, 0.15);
}

.card-wallet .card-link {
  color: var(--primary);
}

.card-wallet .card-link:hover {
  color: #000000;
}

/* Coupons Card */
.card-coupons::before {
  background: var(--danger);
}

.card-coupons .icon-container {
  background: rgba(220, 53, 69, 0.08);
}

.card-coupons .card-icon {
  color: var(--danger);
}

.card-coupons:hover {
  border-color: var(--danger);
}

.card-coupons:hover .icon-container {
  background: rgba(220, 53, 69, 0.15);
}

.card-coupons .card-link {
  color: var(--danger);
}

.card-coupons .card-link:hover {
  color: #bd2130;
}

/* Placeholder Card */
.card-placeholder::before {
  background: var(--text-light);
}

.card-placeholder .icon-container {
  background: rgba(138, 138, 138, 0.08);
}

.card-placeholder .card-icon {
  color: var(--text-light);
}

.card-placeholder:hover {
  border-color: var(--text-light);
}

.card-placeholder:hover .icon-container {
  background: rgba(138, 138, 138, 0.15);
}

.card-placeholder .card-link {
  color: var(--text-light);
}

/* ============================================
   RESPONSIVE DESIGN
   ============================================ */
@media (max-width: 992px) {
  .container {
    padding: 30px;
  }
  
  .dashboard-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
}

@media (max-width: 768px) {
  .container {
    padding: 20px;
  }
  
  .header {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .profile-section {
    gap: 15px;
  }
  
  .profile-image,
  .profile-section .icon-link {
    width: 55px;
    height: 55px;
  }
  
  .profile-text h1 {
    font-size: 1.4rem;
  }
  
  .profile-text h1 span {
    font-size: 1rem;
  }
  
  .logout-btn {
    padding: 10px 20px;
    font-size: 0.8rem;
  }
  
  .dashboard-card {
    padding: 25px;
  }
}

@media (max-width: 540px) {
  .container {
    padding: 15px;
  }
  
  .dashboard-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
  }
  
  .dashboard-card {
    padding: 20px;
  }
  
  .icon-container {
    width: 42px;
    height: 42px;
    margin-bottom: 15px;
  }
  
  .card-icon {
    width: 18px;
    height: 18px;
  }
  
  .dashboard-card h3 {
    font-size: 0.95rem;
  }
  
  .dashboard-card p {
    font-size: 0.8rem;
    margin-bottom: 15px;
  }
  
  .card-link {
    font-size: 0.8rem;
  }
  
  .profile-image,
  .profile-section .icon-link {
    width: 48px;
    height: 48px;
  }
  
  .profile-text h1 {
    font-size: 1.2rem;
  }
  
  .profile-text h1 span {
    font-size: 0.95rem;
  }
}

@media (max-width: 400px) {
  .container {
    padding: 12px;
  }
  
  .dashboard-grid {
    gap: 12px;
  }
  
  .dashboard-card {
    padding: 15px;
  }
  
  .icon-container {
    width: 36px;
    height: 36px;
    margin-bottom: 12px;
  }
  
  .card-icon {
    width: 16px;
    height: 16px;
  }
  
  .dashboard-card h3 {
    font-size: 0.85rem;
    margin-bottom: 6px;
  }
  
  .dashboard-card p {
    font-size: 0.75rem;
    margin-bottom: 12px;
    line-height: 1.3;
  }
  
  .card-link {
    font-size: 0.75rem;
  }
  
  .profile-image,
  .profile-section .icon-link {
    width: 42px;
    height: 42px;
  }
  
  .profile-text h1 {
    font-size: 1.1rem;
  }
  
  .profile-text h1 span {
    font-size: 0.9rem;
  }
  
  .profile-text p {
    font-size: 0.8rem;
  }
  
  .logout-btn {
    padding: 8px 16px;
    font-size: 0.75rem;
  }
}

@media (max-width: 350px) {
  .dashboard-grid {
    gap: 10px;
  }
  
  .dashboard-card {
    padding: 12px;
  }
  
  .icon-container {
    width: 32px;
    height: 32px;
    margin-bottom: 10px;
  }
  
  .card-icon {
    width: 14px;
    height: 14px;
  }
  
  .dashboard-card h3 {
    font-size: 0.8rem;
  }
  
  .dashboard-card p {
    font-size: 0.7rem;
  }
  
  .card-link {
    font-size: 0.7rem;
  }
}
</style>
</head>
<body>

    <%- include('../../views/partials/user/header') %>

    <div class="container">
        <div class="header">
            <div class="profile-section">
                <% if(user?.image) {%>
                    <img src="<%= user.image %>" alt="image" class="profile-image">
                    <% }else{%>
                            <div class="icon-link">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                        </div>
                        <% } %>
                <div class="profile-text">
                    <h1>YOUR ACCOUNT <span><%= user.name %></span></h1>
                    <p>Manage your account settings</p>
                </div>
            </div>
            <a href="/logout" style="text-decoration: none;"><button class="logout-btn">LOGOUT</button></a>
        </div>
        
        <div class="dashboard-grid">
            <!-- Row 1 -->
            <div class="dashboard-card">
                <div class="icon-container">
                    <i class="card-icon" data-lucide="shopping-bag"></i>
                </div>
                <h3>Your Orders</h3>
                <p>Track, return, or cancel orders</p>
                <a href="/orders" class="card-link">View history <i data-lucide="chevron-right" width="14" height="14"></i></a>
            </div>
            
            <div class="dashboard-card card-security">
                <div class="icon-container">
                    <i class="card-icon" data-lucide="lock"></i>
                </div>
                <h3>Login & Security</h3>
                <p>Edit name, password and email</p>
                <a href="/userProfile" class="card-link">Update settings <i data-lucide="chevron-right" width="14" height="14"></i></a>
            </div>
            
            <div class="dashboard-card card-address">
                <div class="icon-container">
                    <i class="card-icon" data-lucide="map-pin"></i>
                </div>
                <h3>Address</h3>
                <p>Add or edit delivery addresses</p>
                <a href="userAddress" class="card-link">Manage addresses <i data-lucide="chevron-right" width="14" height="14"></i></a>
            </div>
            
            <!-- Row 2 -->
            <div class="dashboard-card card-wallet">
                <div class="icon-container">
                    <i class="card-icon" data-lucide="wallet"></i>
                </div>
                <h3>Your Wallet</h3>
                <p>Add or check balance</p>
                <a href="/wallet" class="card-link">View wallet <i data-lucide="chevron-right" width="14" height="14"></i></a>
            </div>
            
            <div class="dashboard-card card-coupons">
                <div class="icon-container">
                    <i class="card-icon" data-lucide="tags"></i>
                </div>
                <h3>Available Coupons</h3>
                <p>Get special offers</p>
                <a href="/coupons" class="card-link">View coupons <i data-lucide="chevron-right" width="14" height="14"></i></a>
            </div>
            
            <div class="dashboard-card card-placeholder">
                <div class="icon-container">
                    <i class="card-icon" data-lucide="plus-circle"></i>
                </div>
                <h3>More features coming soon</h3>
                <p>We're working on new tools for you</p>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>