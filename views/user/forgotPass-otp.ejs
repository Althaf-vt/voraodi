<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Verify OTP</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/forgotPassword.css" />
  <link rel="stylesheet" href="/user/footerStyle.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
</head>
<body>
  <%- include('../../views/partials/user/header') %>
  
  <section class="auth-section">
    <div class="auth-card">
      <div class="icon-container">
        <i class="card-icon" data-lucide="shield"></i>
      </div>
      <h2>Verify OTP</h2>
      <p>Enter the OTP sent to your email to reset your password</p>

      <% if (locals.message && message.length > 0) { %>
        <div class="validation-message">
          <%= message %>
        </div>
      <% } %>
      <% if (locals.successMessage && successMessage.length > 0) { %>
        <div class="validation-message success">
          <%= successMessage %>
        </div>
      <% } %>

      <form class="auth-form" id="verify-otp-form" method="POST" onsubmit="return validateOtpForm()">
        <div class="form-group">
          <label for="otp">OTP Code</label>
          <input type="text" id="otp" name="otp" placeholder="Enter 6-digit OTP" maxlength="6" pattern="\d{6}" required>
        </div>
        
        <div class="otp-timer">Resend available in <span id="timer">60</span> seconds</div>
        
        <div class="form-actions">
          <button type="submit" class="action-button primary">Verify OTP</button>
        </div>
        
        <div class="resend-link">
          <a href="#" id="resend-link" class="disabled" onclick="resendOTP()">Resend OTP</a>
        </div>
      </form>

      <p class="link">
        Already verified? <a href="/signin">Sign In</a>
      </p>
    </div>
  </section>

  <%- include('../../views/partials/user/footer') %>

  <script>
    lucide.createIcons();
    
    function validateOtpForm() {
      const otpInput = document.getElementById('otp').value;
      $.ajax({
        type: 'POST',
        url: '/forgot-pass-otp',
        data: { otp: otpInput },
        success: function(response) {
          if (response.success) {
            Swal.fire({
              icon: 'success',
              title: 'OTP Verified Successfully',
              showConfirmButton: false,
              timer: 1500,
            }).then(() => {
              window.location.href = response.redirectUrl;
            });
          } else {
            Swal.fire({
              icon: 'error',
              title: 'Invalid OTP',
              text: response.message,
            });
          }
        },
        error: function() {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'Failed to Verify OTP. Please try again',
          });
        }
      });
      return false;
    }

    // Timer for Resend OTP
    let timeLeft = 60;
    const resendLink = document.getElementById('resend-link');
    const timerDisplay = document.getElementById('timer');

    const countdown = setInterval(() => {
      timeLeft--;
      timerDisplay.textContent = timeLeft;

      if (timeLeft <= 0) {
        clearInterval(countdown);
        timerDisplay.textContent = '0';
        resendLink.classList.remove('disabled');
        resendLink.style.pointerEvents = 'auto';
      }
    }, 1000);

    // Function to resend OTP
    function resendOTP() {
      $.ajax({
        type: 'POST',
        url: '/resend-forgot-otp',
        success: function(response) {
          if (response.success) {
            Swal.fire({
              icon: 'success',
              title: 'OTP Resent Successfully',
              showConfirmButton: false,
              timer: 1500,
            });

            // Restart the timer
            timeLeft = 60;
            timerDisplay.textContent = timeLeft;
            resendLink.classList.add('disabled');
            resendLink.style.pointerEvents = 'none';

            const newCountdown = setInterval(() => {
              timeLeft--;
              timerDisplay.textContent = timeLeft;

              if (timeLeft <= 0) {
                clearInterval(newCountdown);
                timerDisplay.textContent = '0';
                resendLink.classList.remove('disabled');
                resendLink.style.pointerEvents = 'auto';
              }
            }, 1000);
          } else {
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: 'Failed to resend OTP. Please try again',
            });
          }
        },
        error: function() {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'Failed to resend OTP. Please try again',
          });
        }
      });
    }
  </script>
</body>
</html>