<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Forgot Password</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/user/forgotPassword.css" />
  <link rel="stylesheet" href="/user/footerStyle.css" />
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
  <%- include('../../views/partials/user/header') %>
  
  <section class="auth-section">
    <div class="auth-card">
      <div class="icon-container">
        <i class="card-icon" data-lucide="mail"></i>
      </div>
      <h2>Forgot Password</h2>
      <p>Enter your email address to receive a password reset OTP</p>

      <% if (locals.successMessage && successMessage.length > 0) { %>
        <div class="validation-message success">
          <%= successMessage %>
        </div>
      <% } %>

      <form class="auth-form" id="forgot-password-form" action="/forgot-password" method="POST">
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" required />
          <span class="error-message" data-field="email"></span>
        </div>

        <% if(locals.message && message.length > 0) { %>
          <div class="validation-message">
            <%= message %>
          </div>
        <% } %>

        <div class="form-actions">
          <button type="submit" class="action-button primary">Send OTP</button>
        </div>
      </form>

      <p class="link">
        Remember your password? <a href="/signin">Sign In</a>
      </p>
    </div>
  </section>

  <%- include('../../views/partials/user/footer') %>

  <script>
    lucide.createIcons();
    
    // Hide alerts after 3.5 seconds
    setTimeout(() => {
      const alerts = document.querySelectorAll('.validation-message');
      alerts.forEach(alert => {
        alert.style.transition = 'opacity 0.5s ease';
        alert.style.opacity = '0';
        setTimeout(() => alert.remove(), 500);
      });
    }, 3500);
  </script>
</body>
</html>